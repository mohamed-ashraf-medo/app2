rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidCVDocument(data) {
      return data.keys().hasAll(['id', 'title', 'language', 'header', 'updatedAt'])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 140
        && data.language in ['en', 'ar']
        && data.updatedAt is string;
    }

    // Private per-user profile & CV documents
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /cvs/{cvId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && isValidCVDocument(request.resource.data)
          && request.resource.data.ownerUid == uid;
        allow delete: if isOwner(uid);
      }
    }

    // Opt-in public shared CVs (read-only by link, write-only by owner)
    match /publicCvs/{shareId} {
      allow read: if resource.data.isPublic == true;
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.isPublic == true
        && isValidCVDocument(request.resource.data);
      allow update: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && isValidCVDocument(request.resource.data);
      allow delete: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
